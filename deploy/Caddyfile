# 自架時用 Caddy 而非 nginx：它自動申請並續期 Let's Encrypt 憑證，
# 設定檔只要這幾行。nginx 要做到一樣的事需要 certbot 加十倍設定。
#
# 用法：
#   brew install caddy
#   caddy run --config deploy/Caddyfile
#
# 把 joformosa.example.com 換成你的網域。
# 走 Cloudflare Tunnel 時網域由 Cloudflare 處理，這裡改用 :8080 即可。

joformosa.example.com {
    root * ../build/web
    encode gzip zstd

    # SPA fallback：找不到檔案就送 index.html，交給 go_router
    try_files {path} /index.html
    file_server

    # Flutter 的資源檔名含 hash，可以長快取；
    # index.html 絕對不能快取，否則使用者會一直拿到舊版
    @immutable path *.js *.wasm *.otf *.ttf *.png *.jpg *.svg
    header @immutable Cache-Control "public, max-age=31536000, immutable"
    header /index.html Cache-Control "no-cache"

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }
}
